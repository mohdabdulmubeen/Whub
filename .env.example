# Celpin OAuth 2.0 & OpenID Connect Configuration
# Replace the placeholder values below with your credentials from Google Cloud Console & LinkedIn Developer Portal.

# Google OAuth 2.0 Client ID (Web Application)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins: http://localhost:5173, http://localhost:5174, https://celpin-six.vercel.app
# Authorized Redirect URIs: http://localhost:5173/, http://localhost:5174/, https://celpin-six.vercel.app/
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LinkedIn OAuth 2.0 / OpenID Connect Client ID
# Obtain from: https://www.linkedin.com/developers/apps
# Scopes required: openid, profile, email
# Authorized Redirect URLs: http://localhost:5173/, http://localhost:5174/, https://celpin-six.vercel.app/
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# Optional: Custom Redirect URI (defaults to window.location.origin)
# VITE_REDIRECT_URI=http://localhost:5174/
